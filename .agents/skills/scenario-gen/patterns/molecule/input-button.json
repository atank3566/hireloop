{
  "tier": "molecule",
  "name": "input-button",
  "path": "schema/v1/patterns/molecule/input-button.schema.json",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://flextudio.local/meta-contract/v1/patterns/molecule/input-button.schema.json",
    "title": "pattern.molecule.input-button",
    "description": "입력 컨트롤 + 짧은 액션 버튼 페어 (molecule). 왼쪽에 단말 입력 (InputText / InputNumber / InputMask), 오른쪽에 atom/button 표준 CTA 가 fit 너비로 붙는 가로 페어. 대표 use case: 주소 + '우편번호 검색', 휴대폰 + '인증', 쿠폰 코드 + '적용', 사번 + '직원 검색' — 버튼이 입력값을 외부 lookup 으로 채우거나 값에 대한 액션을 수행하는 패턴.\n\n입력은 Width 100% (남는 공간을 채우되 maxWidth 500px 로 캡, minWidth 는 content 만큼). Caption(라벨) 유무로 Height 자동 분기 — 있으면 70px, 없으면 44px. readOnly 옵션은 버튼이 값을 채우는 lookup 패턴에서 입력 직접 편집을 막을 때 사용 (ControlKey:'ReadOnly').\n\n버튼은 atom/button 의 primary variant + width=fit 을 그대로 호출하여 생성 — 색/높이/타이포는 atom 표준. molecule 은 wrapper(horizontal flex, columnGap 4px, vertical-align bottom) + 입력 디자인만 결정한다. 버튼에 이벤트가 필요하면 별도 후처리 또는 atom/button raw 사용을 권장 (이 molecule 은 시각 + 라벨만 제공).",
    "x-tier": "molecule",
    "x-tags": [
      "input",
      "button",
      "lookup",
      "address",
      "verify",
      "input-with-action"
    ],
    "x-related": [
      "molecule/input-pair",
      "atom/button"
    ],
    "type": "object",
    "additionalProperties": false,
    "required": [
      "inputType",
      "buttonLabel"
    ],
    "properties": {
      "inputType": {
        "type": "string",
        "enum": [
          "inputText",
          "inputNumber",
          "inputMask"
        ],
        "description": "왼쪽 입력 컨트롤 종류. 단말 입력 3종만 허용 — Dialog 합성이 필요한 inputDate / inputSearch 는 이 molecule 대신 input-pair 사용."
      },
      "inputOptions": {
        "type": "object",
        "additionalProperties": false,
        "description": "입력 컨트롤 옵션. 미지정 시 inputType 별 기본값. 모든 필드 optional.",
        "properties": {
          "caption": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30,
            "description": "입력 위에 표시되는 라벨 텍스트. 지정 시 Height 70px(라벨 포함), 미지정 시 44px. CaptionStyle 은 고정 (SemiBold 13 left)."
          },
          "placeholder": {
            "type": "string",
            "maxLength": 80,
            "description": "Placeholder 텍스트. 미지정 시 빈 문자열."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "description": "ControlName / ControlName2 (스튜디오 explorer 식별자 + 데이터 키). 미지정 시 inputType 기반 기본값 (FieldText / FieldNumber / FieldMask)."
          },
          "readOnly": {
            "type": "boolean",
            "default": false,
            "description": "true 면 ControlKey:'ReadOnly' 설정 — 사용자가 직접 입력 못 하고 버튼 액션 결과로만 채워지는 lookup 패턴 (예: 우편번호 검색에서 주소 입력)."
          },
          "textInputType": {
            "type": "string",
            "enum": [
              "text",
              "password",
              "number",
              "email",
              "tel"
            ],
            "description": "inputType=inputText 일 때만. 기본 'text'."
          },
          "numberInputType": {
            "type": "string",
            "enum": [
              "decimal",
              "integer",
              "number"
            ],
            "description": "inputType=inputNumber 일 때만. 기본 'decimal'."
          },
          "format": {
            "type": "string",
            "description": "inputType=inputNumber 의 표시 포맷 (예: '#,###', '#,###.##')."
          },
          "maskInputType": {
            "type": "string",
            "enum": [
              "hhmm",
              "money"
            ],
            "description": "inputType=inputMask 일 때 필수. hhmm=시간 / money=천단위 콤마."
          }
        }
      },
      "buttonLabel": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12,
        "description": "버튼 표시 텍스트. 짧게 유지 (가로 페어에서 입력 옆에 붙는 액션이라 긴 라벨은 레이아웃 깨짐). 예: '검색', '인증', '적용', '확인', '우편번호 검색'. 다국어/바인딩 토큰 가능."
      },
      "override": {
        "type": "object",
        "propertyNames": {
          "enum": [
            "root",
            "input",
            "button"
          ]
        },
        "additionalProperties": {
          "type": "object"
        },
        "description": "(L1 escape hatch) 패턴이 노출하지 않는 raw 엔진 메타데이터를 materialized 트리의 특정 노드에 deep-merge 로 주입한다. anchor 로 위치 지정 — root=외부 Group, input=입력 본체, button=우측 버튼. 값은 엔진 필드 패치 객체이며, 어떤 엔진 스키마에든 정의된 필드명만 검증을 통과한다(예: UseDataConnection, UseMove). 배열 필드는 deep-merge 가 아니라 통째 교체된다. 일반 케이스는 props 로 충분하므로 props 로 표현 못 하는 필드가 필요할 때만 사용.",
        "examples": [
          {
            "input": {
              "UseDataConnection": true
            }
          },
          {
            "root": {
              "UseMove": true,
              "MoveSteps": {
                "MoveStepOrder": [
                  "Step2"
                ],
                "Step2": {
                  "Condition": "",
                  "MoveTo": "Next",
                  "Direction": "toRight"
                }
              }
            }
          }
        ]
      }
    },
    "allOf": [
      {
        "$comment": "inputMask 는 maskInputType 필수.",
        "if": {
          "properties": {
            "inputType": {
              "const": "inputMask"
            }
          },
          "required": [
            "inputType"
          ]
        },
        "then": {
          "required": [
            "inputOptions"
          ],
          "properties": {
            "inputOptions": {
              "required": [
                "maskInputType"
              ]
            }
          }
        }
      }
    ],
    "examples": [
      {
        "inputType": "inputText",
        "inputOptions": {
          "caption": "주소",
          "placeholder": "우편번호",
          "name": "address",
          "readOnly": true
        },
        "buttonLabel": "우편번호 검색"
      },
      {
        "inputType": "inputText",
        "inputOptions": {
          "caption": "휴대폰",
          "placeholder": "010-0000-0000",
          "name": "phone",
          "textInputType": "tel"
        },
        "buttonLabel": "인증"
      },
      {
        "inputType": "inputText",
        "inputOptions": {
          "placeholder": "쿠폰 코드",
          "name": "couponCode"
        },
        "buttonLabel": "적용"
      },
      {
        "inputType": "inputNumber",
        "inputOptions": {
          "caption": "주문 수량",
          "placeholder": "0",
          "name": "qty",
          "numberInputType": "integer",
          "format": "#,###"
        },
        "buttonLabel": "재고 확인"
      }
    ]
  }
}
