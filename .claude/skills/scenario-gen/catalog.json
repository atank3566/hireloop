  "controlTypes": [
    { "value": "InputText",     "description": "한 줄 텍스트 입력 (text/password/number/email/tel).", "isLeaf": true },
    { "value": "InputNumber",   "description": "숫자 입력 (decimal/integer/number).",                  "isLeaf": true },
    { "value": "InputMask",     "description": "마스크 패턴 입력 (hhmm/money 등).",                    "isLeaf": true },
    { "value": "InputDate",     "description": "날짜 입력 + 캘린더 다이얼로그.",                       "isLeaf": false, "hasDialog": "Calendar" },
    { "value": "MultiInputBox", "description": "여러 줄 텍스트 입력 (TextArea).",                      "isLeaf": true },
    { "value": "Combo",         "description": "드롭다운 선택 + ComboList 다이얼로그. 8개 이하 고정 목록.", "isLeaf": false, "hasDialog": "ComboList" },
    { "value": "Search",        "description": "Code Help / Lookup. 키워드 검색 + DataSource 기반.",    "isLeaf": false, "hasDialog": "List" },
    { "value": "CheckBox",      "description": "체크박스. Items[] 다중 항목 또는 단일 토글.",          "isLeaf": true },
    { "value": "RadioBox",      "description": "라디오 그룹. Fixed Items 또는 DataSource.",            "isLeaf": true },
    { "value": "Label",         "description": "텍스트/아이콘 표시. labeltext / LabelCKey 모드.",      "isLeaf": true },
    { "value": "ImageBox",      "description": "이미지 표시/업로드. ImageBoxType=View(ViewGroup) | Edit(ViewGroup+EditGroup).", "isLeaf": true },
    { "value": "InputFile",     "description": "파일 첨부. Attributes.UseCategory + CategoryName 으로 카테고리 누적, Limit 로 개수 제한.",   "isLeaf": true },
    { "value": "Calendar",          "description": "캘린더 picker. InputDate.Dialog 자식 또는 단독 사용. CalendarType(day/month/year) + SelectType(SingleDate/FromTo). 공식: docs.flextudio.com/.../datepicker.", "isLeaf": true },
    { "value": "CalendarNavigator", "description": "캘린더 네비게이터. NavigatorType=Month/WeekPeriod/Day (공식 3종 — 'Custom' AI 생성 금지). TimeTable 내부 또는 독립 사용. Events/DayArea/DaySetting/SelectDay/UseEvents 빈 객체라도 필수. 공식: docs.flextudio.com/.../calendarnavigator.", "isLeaf": true },
    { "value": "Tab",               "description": "탭 컨트롤. Items[].LinkedStepId 로 다른 Step 의 화면을 내부에 렌더. Height 100% 필수, 자기 Step 자기 참조 금지. ★ 내부 LinkedStep 은 StepButton 미렌더 + Step Event(Init/Loaded/...) 미실행 + 서브시나리오 Step 표시 불가 — 초기화는 부모 Step Init 에 통합. 공식: docs.flextudio.com/.../tab.", "isLeaf": false, "hasDialog": null },
    { "value": "Tree",              "description": "계층형 트리. NodeId/ParentId/Title 로 flat array 의 부모-자식 관계 표현. UseMultiData=true 면 체크박스 다중 선택. 이벤트는 TreeOrder + Selected/Checked (Click:'' 빈 문자열 필수). 공식: docs.flextudio.com/.../tree.", "isLeaf": true },
    { "value": "Embed",             "description": "raw HTML 직접 삽입. Embed 속성에 HTML 문자열. <script> 직접 삽입 불가 — 외부 라이브러리는 Step Loaded 에서 f.Script.load() 로 불러와 유니크 id 의 div/canvas 를 잡는 패턴. Caption 반드시 빈 문자열. 외부 라이브러리 URL 은 Scenario.StyleURLs 또는 f.Script.load() 인자. 공식: docs.flextudio.com/.../embed.", "isLeaf": true }
  ],

