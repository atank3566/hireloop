{
  "$comment": "flextudio meta-contract v1 카탈로그. self-contained — schema/md 와 동기화 유지.",
  "version": "v1",

  "stepTypes": [
    {
      "value": "StepView",
      "description": "일반 화면. StepDialogType과 결합해 SlideUp/PopUp 변종 표현."
    },
    {
      "value": "StepSub",
      "description": "다른 시나리오 임베드. Protocol + ScenarioId 필수."
    }
  ],

  "stepDialogTypes": [
    { "value": "",        "description": "일반 풀스크린 뷰." },
    { "value": "SlideUp", "description": "바텀시트형 슬라이드업." },
    { "value": "PopUp",   "description": "중앙 팝업. Width/Height/PopupPosition 필수." }
  ],

  "contentsTypes": [
    { "value": "Group", "description": "컨테이너. Layout이 통합됨." }
  ],

  "controlKeys": [
    { "value": "",         "description": "정상 상태." },
    { "value": "Required", "description": "필수 입력. 런타임 자동 검증." },
    { "value": "ReadOnly", "description": "읽기 전용." },
    { "value": "Hide",     "description": "숨김." },
    { "value": "Disabled", "description": "비활성." }
  ],

  "dataUsages": [
    { "value": "default", "requires": ["UseNewSector:true", "OnlyIfNoSector:true"], "description": "섹터 없으면 생성, 있으면 기존." },
    { "value": "new",     "requires": ["UseNewSector:true"], "description": "진입 시 빈 섹터 자동 생성." },
    { "value": "update",  "requires": ["UseTargetSector:true", "TargetSector.Status=[active]"], "description": "activeSector 읽기+쓰기 바인딩." },
    { "value": "detail",  "requires": ["UseTargetSector:true", "TargetSector.Status=[active]"], "description": "activeSector 읽기 전용 바인딩." },
    { "value": "query",   "requires": ["Group.ScrollType:ScrollY", "Height.MatchText:true"], "description": "그룹 자체가 섹터 수만큼 복제." }
  ],

  "filterTypes": [
    { "value": "Status",    "props": ["Status"],                                 "description": "섹터 상태로 필터." },
    { "value": "Condition", "props": ["ConditionKey", "ConditionOperators", "ConditionValue"], "description": "컬럼 값으로 필터. ConditionValue는 같은 섹터의 필드만 참조 (`{=Field}`)." },
    { "value": "Custom",    "props": ["Script"],                                 "description": "JS 표현식 필터. sector 변수 사용, boolean 반환. 다른 카테고리 참조 시 사용." },
    { "value": "Parent",    "props": ["DCParentKey", "DCChildKey"],              "description": "부모-자식 매칭. 자식 group의 DataConnection에 배치." }
  ],

  "sectorStatuses": [
    { "value": "active",   "description": "활성 (삭제되지 않은) 섹터." },
    { "value": "selected", "description": "선택된 섹터." },
    { "value": "added",    "description": "신규 추가 섹터." },
    { "value": "updated",  "description": "수정된 섹터." },
    { "value": "deleted",  "description": "삭제 표시된 섹터." }
  ],

  "conditionOperators": [
    { "value": "==",         "description": "Equals." },
    { "value": "!=",         "description": "Not equals." },
    { "value": ">",          "description": "Greater than (numeric)." },
    { "value": ">=",         "description": "Greater or equal (numeric)." },
    { "value": "<",          "description": "Less than (numeric)." },
    { "value": "<=",         "description": "Less or equal (numeric)." },
    { "value": "Exists",     "description": "필드에 값 존재 (undefined 아님)." },
    { "value": "Not_Exists", "description": "필드가 비어있음/null/undefined." },
    { "value": "Like",       "description": "패턴 매치 (`%`=any chars, `_`=single char)." },
    { "value": "RegExp",     "description": "JavaScript 정규식." }
  ],

  "dataSourceTypes": [
    { "value": "Fixed",      "requires": ["FixedItems"],            "external": false, "sampleSafe": true,  "description": "정적 인라인 데이터. AI 샘플 생성 권장." },
    { "value": "Grid",       "requires": ["GridItems"],             "external": false, "sampleSafe": true,  "description": "그리드형 인라인 데이터 (헤더 + 행). AI 샘플 생성 가능." },
    { "value": "Collection", "requires": ["CategoryName"],          "external": true,  "sampleSafe": false, "description": "다른 카테고리 참조. 운영 전용." },
    { "value": "Service",    "requires": ["ServiceName"],           "external": true,  "sampleSafe": false, "description": "ServiceBinding 호출. 운영 전용." },
    { "value": "API",        "requires": ["ModuleID"],              "external": true,  "sampleSafe": false, "description": "직접 API 호출. 운영 전용." }
  ],

  "dataSourceNameRules": {
    "blockedChars": ["`", ".", "~", "!", "@", "#", "$", "%", "^", "&", "*", "(", ")", "=", "|", "\\", "'", "\"", ";", ":", "/", "?", ",", "{", "}", "[", "]", "<", ">", " ", "\t", "\n"],
    "engineSource": "studio-util.js#L4225 isIcludeSpecial()",
    "schemaPattern": "^[^`.~!@#$%^&*()=|\\\\'\";:/?,{}\\[\\]<> \\t\\n]+$",
    "minLength": 1,
    "recommendedSuffixes": [
      { "suffix": "_DS",   "usage": "일반 DataSource" },
      { "suffix": "DS",    "usage": "일반 DataSource (camelCase 끝)" },
      { "suffix": "_D",    "usage": "코드/마스터 데이터 (운영 메타 패턴)" },
      { "suffix": "Query", "usage": "쿼리/조회용" },
      { "suffix": "List",  "usage": "목록 데이터" },
      { "suffix": "Items", "usage": "항목 데이터" }
    ],
    "examples": {
      "valid":   ["Cust_D", "EmployeeGridDS", "MenuOptionQuery", "daySettingQuery", "test-DS_v2", "StatusListDS"],
      "invalid": ["Bad.Name", "My DS", "DS!", "${name}", "data/source", "ds@v1"]
    }
  },

  "controlEvents": [
    { "control": "Group",         "orderKey": "ContentEvent",    "events": ["Click", "ScrollEnd"],                "schemaRef": "groupEvents",          "location": "본체" },
    { "control": "InputText",     "orderKey": "InputEventOrder", "events": ["change", "input", "focusin", "focusout"], "schemaRef": "inputEventsFull",       "location": "본체" },
    { "control": "MultiInputBox", "orderKey": "InputEventOrder", "events": ["change", "input", "focusin", "focusout"], "schemaRef": "inputEventsFull",       "location": "본체" },
    { "control": "InputNumber",   "orderKey": "InputEventOrder", "events": ["change"],                            "schemaRef": "inputEventsChangeOnly", "location": "본체" },
    { "control": "InputMask",     "orderKey": "InputEventOrder", "events": ["change"],                            "schemaRef": "inputEventsChangeOnly", "location": "본체" },
    { "control": "InputDate",     "orderKey": "DateOrder",       "events": ["DialogClose"],                       "schemaRef": "dateEvents",           "location": "Dialog…Calendar" },
    { "control": "Combo",         "orderKey": "ComboOrder",      "events": ["change", "DialogClose"],             "schemaRef": "comboEvents",          "location": "Dialog…ComboList" },
    { "control": "Search",        "orderKey": "SearchOrder",     "events": ["change", "Delete", "DialogClose"],   "schemaRef": "searchEvents",         "location": "Dialog…List" },
    { "control": "CheckBox",      "orderKey": "CheckBoxOrder",   "events": ["Click"],                             "schemaRef": "checkBoxEvents",       "location": "본체",       "orderOptional": true },
    { "control": "RadioBox",      "orderKey": null,              "events": ["Click"],                             "schemaRef": "directClickEvents",    "location": "본체" },
    { "control": "Label",         "orderKey": null,              "events": ["Click"],                             "schemaRef": "labelEvents",          "location": "본체 (UseClickEvent + Events.Click)" },
    { "control": "ImageBox",      "orderKey": "ImageEventOrder", "events": ["Click"],                             "schemaRef": "imageBoxEvents",       "location": "본체" },
    { "control": "InputFile",     "orderKey": "InputFileOrder",  "events": ["change"],                            "schemaRef": "inputFileEvents",      "location": "본체" },
    { "control": "Calendar",          "orderKey": "DateOrder",                "events": ["DialogClose"],                                  "schemaRef": "dateEvents",                  "location": "본체 (단독 사용 시 본체, InputDate 자식인 경우에도 본체=Calendar)" },
    { "control": "CalendarNavigator", "orderKey": "CalendarNaviEventsOrder",  "events": ["ClickPrevNextBtn", "OnChangeSwipe", "SelectDay"], "schemaRef": "control/calendar-navigator.schema.json#/.../Events", "location": "본체" },
    { "control": "Tab",               "orderKey": null,                       "events": ["Click"],                                        "schemaRef": "Items[].Events.Click",        "location": "Items 항목별 (본체에 Events 없음)" },
    { "control": "Tree",              "orderKey": "TreeOrder",                "events": ["Selected", "Checked"],                          "schemaRef": "treeEvents",                  "location": "본체. Click:'' 빈 문자열 필수 (운영 컨벤션). Checked 는 UseMultiData=true 전용." },
    { "control": "Embed",             "orderKey": null,                       "events": [],                                               "schemaRef": null,                          "location": "본체에 별도 이벤트 없음 — DOM 조작은 Step Loaded/Init 이벤트(부모 Step) 에서 document.getElementById() 으로 처리." }
  ],

  "stepEvents": [
    { "value": "Init",         "description": "최초 시작 전. 데이터/카테고리 초기화." },
    { "value": "Loaded",       "description": "UI 렌더 후. DOM 의존 작업(Chart/Map/Canvas)." },
    { "value": "OnBackLoaded", "description": "뒤로가기 복귀 시." },
    { "value": "OnLeave",      "description": "이탈 직전. cleanup." },
    { "value": "OnForeground", "description": "앱 포그라운드 복귀 (모바일)." },
    { "value": "ScrollEnd",    "description": "스크롤 끝 도달." }
  ],

  "colorTokens": [
